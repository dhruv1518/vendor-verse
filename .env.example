SECRET_KEY=change_me_in_production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================================
# DATABASE — Supabase PostgreSQL (REQUIRED)
# ============================================================================
# You MUST set this for the project to work. See SETUP_GUIDE.md for full steps.
#
# How to get your DATABASE_URL:
#   1. Go to https://supabase.com/dashboard → open the VendorVerse project
#   2. Click the green "Connect" button (top right)
#   3. Select "Session pooler" under Connection Method
#   4. Select "URI" under Type
#   5. Copy the URL and replace [YOUR-PASSWORD] with your actual DB password
#
# The URL should look like:
#   postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
#
DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres

# ============================================================================
# AI — Google Gemini API (REQUIRED for AI features)
# ============================================================================
# ⚠️  NEVER commit your real API key. This file is safe (.env.example),
#     but your actual .env file must NEVER be pushed to git.
#
# How to get your free Gemini API key:
#   1. Go to https://aistudio.google.com/apikey
#   2. Sign in with your Google account
#   3. Click "Create API Key" → copy it
#   4. Paste it below in your .env file (NOT this .env.example file)
#
# Free tier: 1 million tokens/day — no credit card required.
#
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================================
# EMAIL — SMTP Configuration (REQUIRED for real emails in production)
# ============================================================================
# ⚠️  NEVER commit your real email password or app password.
#
# For Gmail SMTP (free, 500 emails/day):
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification
#   3. Go to App Passwords → Generate one for "Mail"
#   4. Use that 16-character app password below (NOT your Gmail password)
#
# For development, leave these blank — emails print to terminal instead.
#
EMAIL_HOST_USER=your.email@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_app_password_here

